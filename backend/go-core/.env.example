DB_HOST=localhost
DB_PORT=5432
DB_USER=lumina
DB_PASSWORD=your_password_here
DB_NAME=lumina
DB_SSLMODE=disable
SERVER_PORT=8081
JWT_SECRET=your-secret-minimum-32-chars-long
KAFKA_BROKERS=localhost:9092

# Brevo Transactional Email (primary when configured)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply.absenta@gmail.com
BREVO_SENDER_NAME="Tayooli Sales"

# SMTP Email Configuration (secondary - no-op mode if not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@tayooli.com
# Public URL for links in emails. Production: APP_URL=https://tayooli.my.id
# (unset/localhost/http in APP_ENV=production is logged as an error and replaced
# by https://tayooli.my.id, never localhost).
APP_URL=http://localhost:3000