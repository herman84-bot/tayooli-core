# ==============================================================================
# Tayooli ERP Core — Environment Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL 15)
DB_HOST=postgres
DB_PORT=5432
DB_USER=tayooli_app
DB_PASSWORD=change_this_strong_password_in_production
DB_NAME=tayooli_erp
DB_SSLMODE=disable

# Application Security & Auth
# Minimal 32 karakter acak untuk keamanan JWT
JWT_SECRET=super-secret-jwt-key-min-32-chars-long-tayooli

# Domain & URL Configuration
# Ganti dengan domain VPS Anda (contoh: https://erp.domainanda.com)
APP_URL=http://localhost
FRONTEND_ORIGIN=http://localhost

# Brevo HTTP API v3 (Kirim Email Verifikasi & Reset Password)
# Jika dikosongkan, sistem berjalan otomatis dalam mode no-op (log ke console)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@domainanda.com
BREVO_SENDER_NAME="Tayooli ERP"

# Alternatif SMTP (Opsional, dipakai jika Brevo tidak diisi)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@domainanda.com
